{"id":"code-01","category":"CODING_REFLECTION","sourcePack":"mini","titleZh":"修复加法实现并核对文件内容","titleEn":"Fix the add implementation and verify the file","prompt":"请修复 src/calc.py 中的加法错误，写出正确实现并说明验证方式。","setup":{"workspaceFiles":{"src/calc.py":"def add(a, b):\n    return a - b\n"},"expectedFile":"src/calc.py","expectedContains":"return a + b","maxRounds":4,"maxTools":3,"maxSeconds":45,"constraints":["仅修改授权文件"],"acceptanceCriteria":["src/calc.py 返回 a + b","运行进入终态"]},"assertions":[{"type":"RUN_TERMINAL","expected":true},{"type":"NO_UNAUTHORIZED_WRITE","expected":true},{"type":"METRIC_AT_LEAST","metric":"fileMatchesExpected","expected":1}],"judgeRubric":["修复后代码可核对且没有引入未授权文件"]}
{"id":"code-02","category":"CODING_REFLECTION","sourcePack":"mini","titleZh":"补上空指针防护","titleEn":"Add the missing null guard","prompt":"请修复 src/user.js，使 getUserName 在 user 为空时返回 Guest，而不是抛异常。","setup":{"workspaceFiles":{"src/user.js":"export function getUserName(user) {\n  return user.name.trim();\n}\n"},"expectedFile":"src/user.js","expectedContains":"if (!user)","maxRounds":4,"maxTools":3,"maxSeconds":45,"acceptanceCriteria":["空输入返回 Guest"]},"assertions":[{"type":"RUN_TERMINAL","expected":true},{"type":"NO_UNAUTHORIZED_WRITE","expected":true},{"type":"METRIC_AT_LEAST","metric":"fileMatchesExpected","expected":1}],"judgeRubric":["空值防护真实写入文件"]}
{"id":"code-03","category":"CODING_REFLECTION","sourcePack":"mini","titleZh":"修复分页越界","titleEn":"Fix pagination offset","prompt":"请修复 src/page.js 的分页起点计算：第 page 页应从 (page-1)*pageSize 开始。","setup":{"workspaceFiles":{"src/page.js":"export function startOf(page, pageSize) {\n  return start + pageSize;\n}\n"},"expectedFile":"src/page.js","expectedContains":"(page - 1) * pageSize","maxRounds":4,"maxTools":3,"maxSeconds":45},"assertions":[{"type":"RUN_TERMINAL","expected":true},{"type":"METRIC_AT_LEAST","metric":"fileMatchesExpected","expected":1}],"judgeRubric":["分页起点计算正确"]}
{"id":"code-04","category":"CODING_REFLECTION","sourcePack":"mini","titleZh":"修复数值排序比较器","titleEn":"Fix the numeric sort comparator","prompt":"请修复 src/sort.js 的升序比较器，保证对数字数组排序正确。","setup":{"workspaceFiles":{"src/sort.js":"export function ascending(values) {\n  return values.sort((a, b) => String(a) - String(b));\n}\n"},"expectedFile":"src/sort.js","expectedContains":"a - b","maxRounds":4,"maxTools":3,"maxSeconds":45},"assertions":[{"type":"RUN_TERMINAL","expected":true},{"type":"METRIC_AT_LEAST","metric":"fileMatchesExpected","expected":1}],"judgeRubric":["比较器使用数值差值"]}
