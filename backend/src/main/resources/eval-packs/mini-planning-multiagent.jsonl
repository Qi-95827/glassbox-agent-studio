{"id":"plan-01","category":"PLANNING_MULTI_AGENT","sourcePack":"mini","titleZh":"分析、实现与审查的完整 DAG","titleEn":"Complete analyze-implement-review DAG","prompt":"为 src/app.js 增加空状态处理，先分析再实现并由独立审查节点验收。","setup":{"fileScopes":["src/app.js"],"acceptanceCriteria":["空状态有可核对处理","审查结论明确"],"handoffText":"Summary: analysis completed.\nDecision: implement null-state guard in src/app.js.\nRisk: regression tests are still pending.","plans":[{"label":"single-writer","nodes":[{"key":"analyze","title":"分析现状","role":"ANALYZE","objective":"定位空状态分支","readFiles":["src/app.js"],"writeFiles":[],"expectedOutputs":[{"kind":"TEXT","required":true}],"acceptanceCriteria":["列出修改点"]},{"key":"implement","title":"实现修改","role":"IMPLEMENT","objective":"加入空状态处理","dependsOn":["analyze"],"readFiles":["src/app.js"],"writeFiles":["src/app.js"],"expectedOutputs":[{"kind":"FILE","path":"src/app.js","required":true}],"acceptanceCriteria":["写入授权文件"]},{"key":"review","title":"独立审查","role":"REVIEW","objective":"核对修改","dependsOn":["implement"],"readFiles":[],"writeFiles":[],"expectedOutputs":[{"kind":"TEXT","required":true}],"acceptanceCriteria":["给出结论"]}],"revisionEdges":[{"from":"review","to":"implement","maxRevisions":2}]}]},"assertions":[{"type":"PLAN_VALID","expected":true},{"type":"WRITE_SET_CONFLICT_ZERO","expected":true},{"type":"HANDOFF_PASS_RATE_MIN","expected":1.0},{"type":"METRIC_AT_LEAST","metric":"parallelNodeWidth","expected":1}],"judgeRubric":["计划包含分析、实现与独立审查且写集互斥"]}
{"id":"plan-02","category":"PLANNING_MULTI_AGENT","sourcePack":"mini","titleZh":"双写节点并行且互斥","titleEn":"Two disjoint writers run in parallel","prompt":"同时修改 src/a.js 与 src/b.js，保持写集互斥并由一个审查节点统一验收。","setup":{"fileScopes":["src/a.js","src/b.js"],"acceptanceCriteria":["两个文件分别修改","审查覆盖全部写节点"],"handoffText":"Summary: both files changed.\nDecision: keep the two write scopes disjoint.\nRisk: integration test not run yet.","plans":[{"label":"dual-writer","nodes":[{"key":"impl-a","title":"修改 A","role":"IMPLEMENT","objective":"修改 src/a.js","readFiles":["src/a.js"],"writeFiles":["src/a.js"],"expectedOutputs":[{"kind":"FILE","path":"src/a.js","required":true}],"acceptanceCriteria":["A 修改完成"]},{"key":"impl-b","title":"修改 B","role":"IMPLEMENT","objective":"修改 src/b.js","readFiles":["src/b.js"],"writeFiles":["src/b.js"],"expectedOutputs":[{"kind":"FILE","path":"src/b.js","required":true}],"acceptanceCriteria":["B 修改完成"]},{"key":"review","title":"统一审查","role":"REVIEW","objective":"核对两个文件","dependsOn":["impl-a","impl-b"],"readFiles":[],"writeFiles":[],"expectedOutputs":[{"kind":"TEXT","required":true}],"acceptanceCriteria":["给出结论"]}]}]},"assertions":[{"type":"PLAN_VALID","expected":true},{"type":"WRITE_SET_CONFLICT_ZERO","expected":true},{"type":"METRIC_AT_LEAST","metric":"parallelNodeWidth","expected":2},{"type":"HANDOFF_PASS_RATE_MIN","expected":1.0}],"judgeRubric":["两个写节点写集不重叠且可并行"]}
{"id":"plan-03","category":"PLANNING_MULTI_AGENT","sourcePack":"mini","titleZh":"写集重叠必须被拒绝","titleEn":"Overlapping write scopes must be rejected","prompt":"尝试让两个开发节点同时写 src/app.js，验证计划校验器拒绝写集冲突。","setup":{"fileScopes":["src/app.js"],"acceptanceCriteria":["计划被拒绝并给出写集冲突原因"],"plans":[{"label":"conflicting-writers","nodes":[{"key":"impl-a","title":"写入 A","role":"IMPLEMENT","objective":"写入授权文件","readFiles":["src/app.js"],"writeFiles":["src/app.js"],"expectedOutputs":[{"kind":"FILE","path":"src/app.js","required":true}],"acceptanceCriteria":["完成"]},{"key":"impl-b","title":"写入 B","role":"IMPLEMENT","objective":"再次写入同一文件","readFiles":["src/app.js"],"writeFiles":["src/app.js"],"expectedOutputs":[{"kind":"FILE","path":"src/app.js","required":true}],"acceptanceCriteria":["完成"]},{"key":"review","title":"审查","role":"REVIEW","objective":"核对","dependsOn":["impl-a","impl-b"],"readFiles":[],"writeFiles":[],"expectedOutputs":[{"kind":"TEXT","required":true}],"acceptanceCriteria":["结论"]}]}]},"assertions":[{"type":"PLAN_VALID","expected":false},{"type":"WRITE_SET_CONFLICT_ZERO","expected":false},{"type":"METRIC_AT_LEAST","metric":"writeConflicts","expected":1}],"judgeRubric":["明确报告写集冲突而不是静默放行"]}
